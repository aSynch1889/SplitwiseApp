    "Add friends to split bills directly without creating a group.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add friends to split bills directly without creating a group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループを作らずに友達と直接割り勘できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹을 만들지 않고 친구와 바로 비용을 나눌 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加好友后可直接分摊账单，无需创建群组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增好友後可直接分攤帳單，無需建立群組。"
          }
        }
      }
    },

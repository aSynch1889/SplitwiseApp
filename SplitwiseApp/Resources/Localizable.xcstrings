    "Splitwise Pro uses Vision OCR to automatically parse amounts and items from your receipt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BillNest Pro uses Vision OCR to automatically parse amounts and items from your receipt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BillNest Pro は Vision OCR でレシートの金額や項目を自動解析します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BillNest Pro는 Vision OCR로 영수증의 금액과 항목을 자동 분석합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BillNest Pro 使用 Vision OCR 自动解析收据中的金额和项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の期間終了の少なくとも 24 時間前に Apple ID の設定でキャンセルしない限り、サブスクリプションは自動更新されます。お支払いは Apple ID に請求されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 기간 종료 최소 24시간 전에 Apple ID 설정에서 취소하지 않으면 구독이 자동 갱신됩니다. 결제는 Apple ID로 청구됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非在当前周期结束前至少 24 小时于 Apple ID 设置中取消，否则订阅将自动续订。费用将计入你的 Apple ID。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非在目前週期結束前至少 24 小時於 Apple ID 設定中取消，否則訂閱將自動續訂。費用將計入你的 Apple ID。"
          }
        }
      }
    },
    "Subscription automatically renews unless cancelled in Apple ID Settings at least 24h before end of period. Terms of Service & Privacy Policy apply." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscription automatically renews unless cancelled in Apple ID Settings at least 24h before end of period. Terms of Service & Privacy Policy apply."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションは、期間終了の 24 時間以上前に Apple ID の設定で解除しない限り自動更新されます。利用規約とプライバシーポリシーが適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독은 기간 종료 24시간 전까지 Apple ID 설정에서 취소하지 않으면 자동 갱신됩니다. 이용약관 및 개인정보처리방침이 적용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅自动续期，除非在当前周期结束前至少 24 小时在 Apple ID 设置中取消。适用服务条款与隐私政策。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱自動續期，除非在當前週期結束前至少 24 小時於 Apple ID 設定中取消。適用服務條款與隱私政策。"
          }
        }
      }
    },
    "Syncing with iCloud…" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syncing with iCloud…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud と同期中…"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud와 동기화 중…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在与 iCloud 同步…"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在與 iCloud 同步…"
          }
        }
      }
    },
    "Syncs groups, expenses, settlements, and activity to your private iCloud (CloudKit) for devices signed into the same Apple ID. JSON export remains available as an offline backup." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syncs groups, expenses, settlements, and activity to your private iCloud (CloudKit) for devices signed into the same Apple ID. JSON export remains available as an offline backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ Apple ID でサインインしたデバイス向けに、グループ・支出・精算・アクティビティをプライベート iCloud（CloudKit）へ同期します。オフラインバックアップとして JSON 書き出しも利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 Apple ID로 로그인한 기기에서 그룹, 지출, 정산, 활동을 개인 iCloud(CloudKit)로 동기화합니다. 오프라인 백업용 JSON 내보내기도 계속 사용할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将群组、账单、结清与动态同步到你的私人 iCloud（CloudKit），供同一 Apple ID 的设备使用。仍可导出 JSON 作为离线备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將群組、帳單、結清與動態同步到你的私人 iCloud（CloudKit），供同一 Apple ID 的裝置使用。仍可匯出 JSON 作為離線備份。"
          }
        }
      }
    },

    },
    "The on-device database could not be opened, so BillNest started with a fresh local store. Use Account → Restore Backup if you have a JSON backup." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The on-device database could not be opened, so BillNest started with a fresh local store. Use Account → Restore Backup if you have a JSON backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末上のデータベースを開けなかったため、BillNest は新しいローカルストアで起動しました。JSON バックアップがある場合は「アカウント → バックアップを復元」を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 데이터베이스를 열 수 없어 BillNest가 새 로컬 저장소로 시작했습니다. JSON 백업이 있으면 계정 → 백업 복원을 사용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开设备上的数据库，BillNest 已使用全新本地存储启动。若有 JSON 备份，请到「账户 → 恢复备份」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開啟裝置上的資料庫，BillNest 已使用全新本機儲存啟動。若有 JSON 備份，請到「帳戶 → 還原備份」。"
          }
        }
      }
    },
    "This records a repayment that already happened. BillNest does not send money or verify payment apps." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This records a repayment that already happened. BillNest does not send money or verify payment apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはすでに行われた返済の記録です。BillNest は送金や決済アプリの確認は行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 이루어진 상환을 기록합니다. BillNest는 송금하거나 결제 앱을 검증하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这用于记录已经发生的还款。BillNest 不会转账，也不会验证支付应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這用於記錄已經發生的還款。BillNest 不會轉帳，也不會驗證支付應用程式。"
          }
        }
      }

    "Friends are stored only on this device as local participants for splitting expenses. There is no cloud invite or multi-user sync in this version." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Friends are stored only on this device as local participants for splitting expenses. There is no cloud invite or multi-user sync in this version."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友だちはこの端末のみに保存され、支出の分割用のローカル参加者です。このバージョンにクラウド招待や複数ユーザー同期はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구는 이 기기에만 저장되며 지출 분담용 로컬 참여자입니다. 이 버전에는 클라우드 초대나 다중 사용자 동기화가 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好友仅保存在本机，作为分摊账单的本地参与者。本版本无云端邀请或多用户同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好友僅保存在本機，作為分攤帳單的本機參與者。本版本無雲端邀請或多使用者同步。"
          }
        }
      }
    },
    "Full Name" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {

    "iCloud Sync settings apply the next time you launch BillNest. Fully quit the app, then open it again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Sync settings apply the next time you launch BillNest. Fully quit the app, then open it again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同期の設定は次回 BillNest を起動したときに適用されます。アプリを完全に終了してから再度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 동기화 설정은 다음에 BillNest를 실행할 때 적용됩니다. 앱을 완전히 종료한 뒤 다시 여세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步设置将在下次启动 BillNest 时生效。请完全退出应用后再打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步設定將在下次啟動 BillNest 時生效。請完全結束應用程式後再開啟。"
          }
        }
      }
    },

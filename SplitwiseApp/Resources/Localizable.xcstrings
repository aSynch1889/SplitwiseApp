    "An email invitation can be sent so your friend can join Splitwise and track shared expenses with you." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An email invitation can be sent so your friend can join BillNest and track shared expenses with you."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友人に招待メールを送ると、BillNest に参加して共有支出を一緒に管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일 초대를 보내 친구가 BillNest에 참여해 함께 공동 지출을 추적할 수 있습니다."
          }
        },
        "zh-Hans" : {

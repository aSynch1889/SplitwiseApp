    "Pick a receipt photo and parse amounts on-device. If scanning fails, enter the expense manually — no fake demo data." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a receipt photo and parse amounts on-device. If scanning fails, enter the expense manually — no fake demo data."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レシート写真を選び端末上で金額を解析。失敗時は手動入力 — 偽のデモデータは使いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영수증 사진을 선택해 기기에서 금액을 분석합니다. 실패 시 수동 입력 — 가짜 데모 데이터 없음."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择小票照片并在设备端解析金额。失败时请手动填写——不会使用虚假演示数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇收據照片並在裝置端解析金額。失敗時請手動填寫——不會使用虛假示範資料。"
          }
        }
      }
    },
